# @dialect: AGENTFABRIC=1.0

system:
  instructions: "Coordinates the order support agent, the MCP tools and the LLM for the TechWave Electronics support demo."

config:
  agent_name: "demo-omni-broker"
  label: "Demo Omni Broker"
  description: "Coordinates the order support agent, the MCP tools and the LLM for the TechWave Electronics support demo."
  default_llm: @llm.azure_gpt


# -- LLM ----------------------------------------------------------------------
# Azure OpenAI usa kind "OpenAI" (só o Bedrock OpenAI difere, com prefixo
# "openai." no nome do modelo). O endpoint exigido pelo broker é /responses.

llm:
  azure_gpt:
    target: "llm://azureOpenAiConnection"
    kind: "OpenAI"
    model: "gpt-5.4-mini"


# -- ACTION DEFINITIONS -------------------------------------------------------

actions:
  order_support_agent:
    target: "a2a://demoSupportAgentConnection"
    kind: "a2a:send_message"

  # NOTE: no schema 2.0, cada tool MCP precisa ser declarada explicitamente
  # (o v1 referenciava o mcpServer inteiro). Nomes reais expostos pelo
  # demo-support-mcp-server (support-tools.xml):
  get_order_status:
    target: "mcp://mcpServerConnection"
    kind: "mcp:tool"
    tool_name: "get-order-status"

  create_support_case:
    target: "mcp://mcpServerConnection"
    kind: "mcp:tool"
    tool_name: "create-support-case"

  refund_payment:
    target: "mcp://mcpServerConnection"
    kind: "mcp:tool"
    tool_name: "refund-payment"

  notify_team:
    target: "mcp://mcpServerConnection"
    kind: "mcp:tool"
    tool_name: "notify-team"


# -- TRIGGER ------------------------------------------------------------------

trigger demoOmniBrokerTrigger:
  kind: "a2a"
  target: "brokers://demo-omni-broker/a2a"
  on_message: ->
    transition to @orchestrator.demoOmniAssistant


# -- ORCHESTRATION ------------------------------------------------------------

orchestrator demoOmniAssistant:
  description: "Decides whether to answer with the MCP tools directly or delegate to the order support agent."
  label: "Demo Omni Assistant"
  system:
    instructions: |
      You are the TechWave Electronics customer support assistant. Use the available agent and MCP tools to answer questions about orders and to resolve support requests.
      For simple read-only questions, such as checking the status of a single order, call the MCP tools directly instead of delegating. Delegate to the agent only when the task requires multi-step actions such as refunds, support cases, or team notifications.
  reasoning:
    instructions: -> @request.payload.message.parts[0].text
    actions:
      order_support_agent: @actions.order_support_agent
      get_order_status: @actions.get_order_status
      create_support_case: @actions.create_support_case
      refund_payment: @actions.refund_payment
      notify_team: @actions.notify_team
    outputs:
      properties:
        summary:
          type: "string"
          description: "Plain-text summary of all actions taken."
    max_number_of_loops: 25
  on_exit: ->
    transition to @echo.demoOmniResponse


# -- RESPONSE -----------------------------------------------------------------

echo demoOmniResponse:
  kind: "a2a:status_update_event"
  state: "TASK_STATE_COMPLETED"
  message: a2a.message({
    messageId: uuid(),
    parts: [
      a2a.textPart(@orchestrator.demoOmniAssistant.output.summary)
    ]
  })
